# =============================================================================
# PROG2002 A3 - team40 - repository .gitignore
#
# This file decides what is NOT committed to GitHub. All three projects
# (api / ng-client / ng-admin) live at the root of this repository.
# =============================================================================

# ---- dependencies (reinstalled with npm install) ---------------------------
node_modules/

# ---- environment files: NEVER commit a real database password ---------------
.env
.env.local
.env.*.local

# ---- build output (regenerated by npm run build) ---------------------------
dist/
.angular/
*.tsbuildinfo

# ---- builds copied into the API for cPanel (tools/build_all.ps1) -----------
api/public/client/
api/public/admin/

# ---- generated documentation (npm run docs) --------------------------------
api/docs/
ng-client/docs/
ng-admin/docs/

# ---- generated deliverables and temporary files ----------------------------
submission/
*.zip
*.log
npm-debug.log*
yarn-error.log*
tmp/
temp/
Thumbs.db
Desktop.ini

# ---- python caches (used by the tools) -------------------------------------
__pycache__/
*.pyc

# ---- editors: ignore contents but keep the VS Code launch configuration ----
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.swp
*~

# ---- operating systems -----------------------------------------------------
.DS_Store

# ---- commit helpers: uploading tools, not project code ---------------------
_commit_plan.json
commit.ps1
commits.ps1

# ---- these must be kept (overrides the exclusions above) -------------------
!api/sql/charityevents_db.sql
!deploy/*.htaccess
